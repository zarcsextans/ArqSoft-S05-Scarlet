@{
    ViewData["Title"] = "Privacidad";
}

<div class="card shadow">

    <div class="card-header bg-primary text-white">

        <h2 class="mb-0">
            Política de Privacidad
        </h2>

    </div>

    <div class="card-body">

        <h4>Uso de la Información</h4>

        <p>
            Este sistema ha sido desarrollado con fines académicos para la gestión
            de pacientes, médicos y citas médicas.
        </p>

        <hr />

        <h4>Almacenamiento de Datos</h4>

        <p>
            La información es almacenada mediante archivos JSON y utilizada
            exclusivamente para fines educativos.
        </p>

        <hr />

        <h4>Seguridad</h4>

        <p>
            Los datos presentados son de ejemplo y no corresponden a información
            médica real.
        </p>

        <hr />

        <h4>Objetivo del Proyecto</h4>

        <p>
            Demostrar la implementación de ASP.NET Core MVC, navegación mediante
            URLs, uso de vistas y persistencia de datos en archivos JSON.
        </p>

    </div>

    <div class="card-footer text-center text-muted">

        Sistema de Gestión de Citas Médicas © 2026

    </div>

</div>