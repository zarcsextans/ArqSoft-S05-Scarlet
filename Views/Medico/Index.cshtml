@model List<CitasApp.Models.Medico>

<h2>Médicos</h2>

<table border="1" cellpadding="8">
    <tr>
        <th>Nombre Completo</th>
        <th>Especialidad</th>
        <th>Acciones</th>
    </tr>

    @foreach (var medico in Model)
    {
        <tr>
            <td>@medico.Nombre @medico.Apellido</td>
            <td>@medico.Especialidad</td>
            <td>
                <a href="/Medico/Detalle/@medico.Id">
                    Ver detalle
                </a>
            </td>
        </tr>
    }
</table>